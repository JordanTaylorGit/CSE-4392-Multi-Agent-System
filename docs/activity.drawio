          <mxGeometry as="geometry" x="231" y="2186" width="1139" height="32" />
        </mxCell>
        <mxCell id="note4" parent="1" vertex="1" value="Refactored repair compilation failures retry repair. Coverage excludes main(); missing or empty reports cannot pass." style="text;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontSize=22;">
          <mxGeometry as="geometry" x="238" y="2226" width="1124" height="32" />
        </mxCell>
        <mxCell id="note5" parent="1" vertex="1" value="Graph concurrency does not guarantee simultaneous Ollama inference. Model output never approves a human gate." style="text;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=none;fontSize=22;">
          <mxGeometry as="geometry" x="236" y="2266" width="1128" height="32" />
        </mxCell>
      </root>
