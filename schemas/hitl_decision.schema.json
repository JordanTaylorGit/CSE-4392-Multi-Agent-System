{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hitl_decision.schema.json",
  "title": "Human-in-the-loop decision record",
  "type": "object",
  "required": ["gate", "reviewer", "timestamp_utc", "decision", "requested_changes"],
  "additionalProperties": false,
  "properties": {
    "gate": { "enum": ["review_testcases", "review_refactored"] },
    "reviewer": { "type": "string", "minLength": 1 },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["accept", "request_changes"] },
    "requested_changes": { "type": "array", "items": { "type": "string" } },
    "artifact_sha256": { "type": "string" },
    "resulting_diff": { "type": "string" }
  }
}
